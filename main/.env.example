# GridSenpAI local runtime configuration
#
# This file is optional. Real OS environment variables still override these
# values when both are present.

GRIDSENPAI_ENV=local-dev
GRIDSENPAI_LOG_LEVEL=INFO
GRIDSENPAI_LOGGER_NAME=gridsenpai

# Retrieval behavior
GRIDSENPAI_TOP_K=5
GRIDSENPAI_RERANK=false
GRIDSENPAI_VENDOR_CORPUS=equipment_catalog
GRIDSENPAI_MODELING_CORPUS=modeling_references

# Governed run provenance
# prompt_template_version tracks the active bounded-assist prompt contract.
GRIDSENPAI_PROMPT_TEMPLATE_VERSION=governed-field-resolution-v1
# model_version is optional; if omitted, GridSenpAI infers it from the active
# local runtime configuration, for example: llama-cpp::local-qwen
# GRIDSENPAI_MODEL_VERSION=llama-cpp::local-qwen
GRIDSENPAI_ALLOW_MODEL_ASSISTANCE=true

# Local llama.cpp runtime
# Choose provider llama_cpp for local GGUF inference. IBM Granite GGUF models work through the same provider.
GRIDSENPAI_LLM_RUNTIME_ENABLED=true
GRIDSENPAI_LLM_PROVIDER=llama_cpp
GRIDSENPAI_LLM_MODEL_ALIAS=local-qwen
GRIDSENPAI_LLM_MODEL_PATH=<path to model>
GRIDSENPAI_LLM_N_CTX=32768
GRIDSENPAI_LLM_N_THREADS=12
GRIDSENPAI_LLM_N_BATCH=512
GRIDSENPAI_LLM_N_GPU_LAYERS=40
GRIDSENPAI_LLM_TEMPERATURE=0.1
GRIDSENPAI_LLM_TOP_P=0.95
GRIDSENPAI_LLM_MAX_TOKENS=512


# IBM watsonx Granite API runtime
GRIDSENPAI_WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRIDSENPAI_WATSONX_API_KEY=
GRIDSENPAI_WATSONX_PROJECT_ID=
GRIDSENPAI_WATSONX_SPACE_ID=
GRIDSENPAI_WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
GRIDSENPAI_WATSONX_API_VERSION=2024-10-08
GRIDSENPAI_WATSONX_IAM_URL=https://iam.cloud.ibm.com/identity/token
GRIDSENPAI_WATSONX_TIME_LIMIT_MS=10000

GRIDSENPAI_AUDIT_MODE=0
GRIDSENPAI_DEBUG_MODE=0
GRIDSENPAI_EXPORT_PLANNER_PACKET_MD=0
GRIDSENPAI_EXPORT_PLANNER_PACKET_DOCX=0
GRIDSENPAI_EXPORT_TLDR_DOCX=0

# OCR runtime
# Leave enabled for normal app runs. Pytest overrides this to false in tests/conftest.py.
GRIDSENPAI_OCR_RUNTIME_ENABLED=true
GRIDSENPAI_OCR_LANG=en
GRIDSENPAI_OCR_RENDER_SCALE=1.5
GRIDSENPAI_OCR_TEXT_DETECTION_MODEL=PP-OCRv5_server_det
GRIDSENPAI_OCR_TEXT_RECOGNITION_MODEL=PP-OCRv5_server_rec

# =========================
# Bounded assist agent prompt budgets
# These are separate from the LLM model context window.
# =========================
GRIDSENPAI_AGENT_MAX_PROMPT_CHARS=24000
GRIDSENPAI_AGENT_MAX_RESPONSE_CHARS=2500
GRIDSENPAI_AGENT_MAX_PACKET_FIELDS=25
GRIDSENPAI_AGENT_MAX_EVIDENCE_CHARS=1200
GRIDSENPAI_DOCUMENT_AGENT_MAX_PROMPT_CHARS=16000
GRIDSENPAI_EVIDENCE_AGENT_MAX_PROMPT_CHARS=20000
GRIDSENPAI_ADJUDICATION_AGENT_MAX_PROMPT_CHARS=24000
GRIDSENPAI_INTERVIEW_AGENT_MAX_PROMPT_CHARS=16000
GRIDSENPAI_PLANNER_AGENT_MAX_PROMPT_CHARS=24000
